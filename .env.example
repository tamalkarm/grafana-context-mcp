GRAFANA_URL=https://grafana.example.com
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_read_only_token
# Optional when the token can access multiple organizations:
# GRAFANA_ORG_ID=1
# GRAFANA_TIMEOUT_SECONDS=30
# GRAFANA_VERIFY_SSL=true

# Optional Azure Monitor Logs Ingestion API configuration:
# AZURE_MONITOR_ENDPOINT=https://<dcr-endpoint>.<region>-1.ingest.monitor.azure.com
# AZURE_MONITOR_DCR_RULE_ID=dcr-immutable-id
# AZURE_MONITOR_EVENT_DCR_RULE_ID=dcr-event-immutable-id
# AZURE_MONITOR_STREAM_NAME=Custom-DemoApplicationLogs
# AZURE_MONITOR_EVENT_STREAM_NAME=Custom-DemoApplicationEvents
# APP_ENVIRONMENT=demo
# For a user-assigned managed identity only:
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# For local/service-principal authentication only (prefer VM managed identity):
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=store-outside-source-control

# Grafana Azure Monitor datasource defaults:
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
