{
  "annotations": {
    "list": []
  },
  "description": "Golden signals and runtime telemetry for the single-VM Python demo application.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-demo"},
      "description": "Total application request throughput over the selected interval.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum(rate(demo_http_requests_total{job=\"demo-app\",route!=\"/metrics\"}[$__rate_interval]))", "legendFormat": "requests / second", "range": true, "refId": "A"}],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-demo"},
      "description": "95th percentile latency estimated from the request-duration histogram.",
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(demo_http_request_duration_seconds_bucket{job=\"demo-app\",route=\"/api/work\"}[$__rate_interval])))", "legendFormat": "p95 latency", "range": true, "refId": "A"}],
      "title": "Work endpoint p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-demo"},
      "description": "Percentage of /api/work responses with a 5xx status.",
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.1}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"editorMode": "code", "expr": "sum(rate(demo_http_requests_total{job=\"demo-app\",route=\"/api/work\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(demo_http_requests_total{job=\"demo-app\",route=\"/api/work\"}[$__rate_interval])), 0.000001)", "instant": false, "legendFormat": "error ratio", "range": true, "refId": "A"}],
      "title": "Error ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-demo"},
      "description": "Successful and failed synthetic jobs per second.",
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (outcome) (rate(demo_jobs_completed_total{job=\"demo-app\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "range": true, "refId": "A"}],
      "title": "Job outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-demo"},
      "description": "Resident memory used by the Python process.",
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"editorMode": "code", "expr": "process_resident_memory_bytes{job=\"demo-app\"}", "legendFormat": "resident memory", "range": true, "refId": "A"}],
      "title": "Process memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus-demo"},
      "description": "Rate of HTTP 5xx responses by route. Run scripts/invoke-crash-spike.ps1 to generate a visible /api/crash spike while correlated exceptions are sent to Log Analytics.",
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (route) (rate(demo_http_requests_total{job=\"demo-app\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{route}}", "range": true, "refId": "A"}],
      "title": "HTTP 5xx spike by route",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
